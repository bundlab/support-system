# ========================================
# AI Support System - Environment Variables
# ========================================

# Rails Configuration
RAILS_ENV=development
SECRET_KEY_BASE=your_very_long_and_secure_secret_key_here

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_USERNAME=your_postgres_username
DATABASE_PASSWORD=your_postgres_password
DATABASE_NAME=ai_support_system_development

# Redis (for Action Cable and Sidekiq)
REDIS_URL=redis://localhost:6379/1

# Email Configuration (Optional)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USER_NAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_DOMAIN=yourdomain.com

# AI Configuration (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Alternative AI Providers
# ANTHROPIC_API_KEY=
# GROK_API_KEY=

# File Uploads (Active Storage)
# For local development (default)
ACTIVE_STORAGE_SERVICE=local

# For production with S3 (uncomment when needed)
# ACTIVE_STORAGE_SERVICE=amazon
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=your-bucket-name

# Application Settings
DEFAULT_FROM_EMAIL=support@yourdomain.com
APP_NAME="AI Support System"
APP_HOST=localhost:3000

# Sidekiq (Background Jobs)
SIDEKIQ_CONCURRENCY=5